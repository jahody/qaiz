rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Each signed-in user can read and write only their own progress document, users/{uid},
// and only with the fields the app syncs (see SyncedProgress in src/utils/sync.ts).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['hearts', 'lastHeartRefill', 'streak', 'lastStreakDate', 'xp', 'completedLessons', 'updatedAt', 'resetAt'])
        && request.resource.data.completedLessons is list
        && request.resource.data.completedLessons.size() <= 500;
    }
  }
}
